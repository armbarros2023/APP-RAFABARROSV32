# Environment
NODE_ENV=production

# Server
PORT=5000

# Database - VPS Hostinger
# IMPORTANTE: Substitua os valores abaixo com as informações da sua VPS
DATABASE_URL=postgresql://clinicapp:SUA_SENHA_AQUI@IP_DA_VPS:5432/app-rafabarros

# JWT
JWT_SECRET=your-production-secret-key-change-this-to-something-secure
JWT_EXPIRES_IN=7d

# CORS - Domínio de produção
CORS_ORIGIN=https://seudominio.com.br

# AI
GEMINI_API_KEY=your-production-gemini-api-key-here

# Admin Seed
ADMIN_NAME=Admin Example
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
